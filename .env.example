# Copy to .env for local work. In production set these as private service variables; never commit values.
# Every variable is explained in docs/CONFIGURATION.md.

# --- Server ---
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
# Number of trusted proxies in front of the server. Default: 1 in production, 0 otherwise.
TRUST_PROXY_HOPS=
RATE_LIMITS_ENABLED=true
LOG_REQUESTS=
# Optional https Discord webhook for error alerts.
ALERT_WEBHOOK_URL=

# --- Database (leave DATABASE_URL blank locally to use data/db.json) ---
DATABASE_URL=
# disable | verify-full. PG_CA_CERT holds a certificate (\n for line breaks) and turns on checking.
PGSSLMODE=
PG_CA_CERT=
PG_POOL_MAX=10

# --- Launch gates (production defaults: wagers and deposits OFF) ---
WAGERS_ENABLED=
DEPOSITS_ENABLED=
WITHDRAWALS_ENABLED=true
# Both must be https addresses of professionally reviewed documents before wagers or deposits can open.
TERMS_URL=
PRIVACY_URL=
# 18 or higher.
MINIMUM_AGE=18

# Percentage DonutSMP keeps from each /pay (default 2). Players send extra so their full deposit arrives.
DONUTSMP_PAY_TAX_PERCENT=2

# --- PvP tiers: off until MCPVP has approved access. See docs/TIERS.md. ---
MCPVP_ENABLED=false
# Must contain {uuid} (one player) or {offset} (paged list).
MCPVP_API_URL=
MCPVP_API_KEY=
MCPVP_REFRESH_HOURS=12

# --- Discord sign-in ---
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=replace_with_your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
DONUT_WAGERS_ADMIN_DISCORD_ID=your_discord_user_id

# --- Discord bot: staff tickets, announcements, bans (optional) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_TICKET_CATEGORY_ID=
DISCORD_STAFF_ROLE_ID=
# Role given to every tournament winner (bot needs Manage Roles, and its role must sit above this one). Empty turns it off.
DISCORD_TOURNAMENT_WINNER_ROLE_ID=1543719308562137291
DISCORD_ANNOUNCEMENT_CHANNEL_ID=

# --- Minecraft bot ---
DONUT_WAGERS_BOT_USERNAME=DonutWagersBot
DONUT_WAGERS_BOT_WEBHOOK_SECRET=replace_with_a_long_random_shared_secret

# --- Optional integrations ---
DONUT_SMP_API_URL=
DONUT_SMP_API_KEY=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# --- Public community links. Remove a line to use the built-in link, or leave YouTube, X, or TikTok empty to hide it. ---
DISCORD_INVITE_URL=https://discord.gg/pnBcnxKPF6
YOUTUBE_URL=https://www.youtube.com/@Donutwagers
X_URL=https://x.com/donutwagers
TIKTOK_URL=https://www.tiktok.com/@donutwagersgg
