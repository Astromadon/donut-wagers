  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  }
}
